# Copy to .env. Throwaway lab credentials only, never reuse real passwords.
COMPOSE_PROJECT_NAME=pgmcplab

# Postgres
POSTGRES_DB=lab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=lab_postgres_pw
MCP_READONLY_PASSWORD=lab_readonly_pw
MCP_ADMIN_PASSWORD=lab_admin_pw

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@pgmcplab.dev
PGADMIN_DEFAULT_PASSWORD=lab_pgadmin_pw

# MCP Inspector
MCP_INSPECTOR_API_TOKEN=lab-inspector-token
