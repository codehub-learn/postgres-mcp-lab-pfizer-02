# syntax=docker/dockerfile:1
# PostgreSQL 18 (alpine) + hypopg compiled from a pinned release.
# pg_stat_statements is a contrib module already shipped in the base image.
ARG PG_IMAGE=postgres:18.6-alpine

FROM ${PG_IMAGE} AS build
ARG HYPOPG_VERSION=1.4.3
RUN apk add --no-cache build-base postgresql-dev curl tar
WORKDIR /src
RUN curl -fsSL "https://github.com/HypoPG/hypopg/archive/refs/tags/${HYPOPG_VERSION}.tar.gz" | tar xz --strip-components=1 \
 && make with_llvm=no \
 && make with_llvm=no install DESTDIR=/out \
 && find /out -type f

FROM ${PG_IMAGE}
# Copy only the built artifacts, no compilers in the final image.
COPY --from=build /out/usr/local/lib/postgresql/hypopg.so /usr/local/lib/postgresql/
COPY --from=build /out/usr/local/share/postgresql/extension/ /usr/local/share/postgresql/extension/
